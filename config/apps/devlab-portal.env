# ==============================================================================
# DevLab Portal Application Configuration
# ==============================================================================

APP_ID="devlab-portal"
APP_NAME="DevLab Portal"
APP_DIR="${DEVLAB_ROOT}/devlab-portal"
DEV_REPO_DIR="${REPOS_DIR}/devlab-portal"

# Database Target
DB_NAME="devlab_portal"
DEV_DB_NAME="devlab_portal_dev"
DB_HOST="${DEFAULT_DB_HOST}"
DB_PORT="${DEFAULT_DB_PORT}"
DB_USER="${DEFAULT_DB_USER}"

# Port Blueprint
WEB_PORT=3010
API_PORT=4010

# Endpoints
WEB_URL="http://localhost:3010"
API_URL="http://localhost:4010"
HEALTH_URL="http://localhost:4010/.well-known/jwks.json"
DOCS_URL="http://localhost:4010/api/docs"

# Process Execution Commands (Executed inside APP_DIR)
API_START_CMD="(cd apps/api && node dist/main.js)"
WEB_START_CMD="(cd apps/web && pnpm next start -p \$WEB_PORT)"
BUILD_CMD="pnpm build"
MIGRATE_CMD="pnpm db:push && pnpm db:generate"

# Required Build Artifacts
BUILD_CHECK_API="apps/api/dist/main.js"
BUILD_CHECK_WEB="apps/web/.next"
