# ==============================================================================
# OrchestrAI Application Configuration
# ==============================================================================

APP_ID="orchestrai"
APP_NAME="OrchestrAI"
APP_DIR="${DEVLAB_ROOT}/orchestrai"
DEV_REPO_DIR="${REPOS_DIR}/orchestrai"

# Database Target
DB_NAME="orchestrai"
DEV_DB_NAME="orchestrai_dev"
DB_HOST="${DEFAULT_DB_HOST}"
DB_PORT="${DEFAULT_DB_PORT}"
DB_USER="${DEFAULT_DB_USER}"

# Port Blueprint
WEB_PORT=3011
API_PORT=4011
REALTIME_PORT=4012
WORKER_PORT=4013

# Endpoints
WEB_URL="http://localhost:3011"
API_URL="http://localhost:4011"
HEALTH_URL="http://localhost:4011/health"
REALTIME_URL="http://localhost:4012/health"
DOCS_URL="http://localhost:4011/docs"

# Process Execution Commands (Executed inside APP_DIR)
API_START_CMD="(cd apps/gateway && node dist/index.js)"
WEB_START_CMD="(cd apps/console && pnpm next start -p \$WEB_PORT)"
REALTIME_START_CMD="(cd apps/realtime && node dist/index.js)"
WORKER_START_CMD="(cd apps/worker && node dist/index.js)"
BUILD_CMD="pnpm build"
MIGRATE_CMD="pnpm db:migrate && pnpm db:generate"

# Required Build Artifacts
BUILD_CHECK_API="apps/gateway/dist/index.js"
BUILD_CHECK_WEB="apps/console/.next"
