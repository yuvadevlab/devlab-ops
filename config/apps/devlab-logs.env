# ==============================================================================
# DevLab Logs Application Configuration
# ==============================================================================

APP_ID="devlab-logs"
APP_NAME="DevLab Logs"
APP_DIR="${DEVLAB_ROOT}/devlab-logs"
DEV_REPO_DIR="${REPOS_DIR}/devlab-logs"

# Database Target
DB_NAME="devlab_logs"
DEV_DB_NAME="devlab_logs_dev"
DB_HOST="${DEFAULT_DB_HOST}"
DB_PORT="${DEFAULT_DB_PORT}"
DB_USER="${DEFAULT_DB_USER}"

# Port Blueprint
WEB_PORT=3013
API_PORT=4013

# Endpoints
WEB_URL="http://localhost:3013"
API_URL="http://localhost:4013"
HEALTH_URL="http://localhost:4013/health"
DOCS_URL="http://localhost:4013/api/docs"

# Process Execution Commands (Executed inside APP_DIR)
API_START_CMD="(cd apps/ingest && node dist/main.mjs)"
WEB_START_CMD="(cd apps/web && pnpm next start -p \$WEB_PORT)"
BUILD_CMD="pnpm build"

# Required Build Artifacts
BUILD_CHECK_API="apps/ingest/dist/main.mjs"
BUILD_CHECK_WEB="apps/web/.next"
