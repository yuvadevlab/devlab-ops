# ==============================================================================
# VitalAI Application Configuration — DevLab Ops
# ==============================================================================

APP_ID="vitalai"
APP_NAME="VitalAI"
APP_DIR="${DEVLAB_ROOT}/vitalai"
DEV_REPO_DIR="${REPOS_DIR}/vitalai"

# Database Target
DB_NAME="vitalai"
DEV_DB_NAME="vitalai_dev"
DB_HOST="${DEFAULT_DB_HOST}"
DB_PORT="${DEFAULT_DB_PORT}"
DB_USER="${DEFAULT_DB_USER}"

# Port Blueprint (Guaranteed non-conflicting across DevLab platform)
WEB_PORT=3014
API_PORT=4014
REALTIME_PORT=""
WORKER_PORT=""

# Endpoints
WEB_URL="http://localhost:3014"
API_URL="http://localhost:4014"
HEALTH_URL="http://localhost:4014/health"
DOCS_URL="http://localhost:4014/api/docs"
GRAPHIQL_URL="http://localhost:4014/graphiql"

# Process Execution Commands (Executed inside APP_DIR)
API_START_CMD="(cd apps/api && node dist/main.js)"
WEB_START_CMD="(cd apps/web && pnpm next start -p \$WEB_PORT)"
BUILD_CMD="pnpm build"
MIGRATE_CMD="pnpm db:migrate:deploy && pnpm db:generate"

# Required Build Artifacts
BUILD_CHECK_API="apps/api/dist/main.js"
BUILD_CHECK_WEB="apps/web/.next"
