# ==============================================================================
# DevLab Ops — Platform Global Configuration
# ==============================================================================
# All paths are dynamically computed relative to DEVLAB_OPS_DIR and PRODUCTION_DIR.
# Modifying this single file instantly reflects across all modules and apps.
# ==============================================================================

# Dynamic path resolution (never hardcodes absolute user paths)
DEVLAB_OPS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PRODUCTION_DIR="$(cd "${DEVLAB_OPS_DIR}/.." && pwd)"
DEVLAB_ROOT="${PRODUCTION_DIR}"

# Core System Directories
LOGS_DIR="${PRODUCTION_DIR}/logs"
BACKUPS_DIR="${PRODUCTION_DIR}/backups"
REPOS_DIR="$(cd "${PRODUCTION_DIR}/../repos" 2>/dev/null && pwd || echo "${PRODUCTION_DIR}/../repos")"

# Operational Defaults
RETENTION_DAYS=14
DEFAULT_DATE_FORMAT="%Y-%m-%d"
DEFAULT_TIMESTAMP_FORMAT="%Y-%m-%d_%H%M%S"

# PostgreSQL Client Binaries
PG_DUMP_BIN="$(which pg_dump 2>/dev/null || echo "/opt/homebrew/bin/pg_dump")"
PSQL_BIN="$(which psql 2>/dev/null || echo "/opt/homebrew/bin/psql")"

# Database Defaults
DEFAULT_DB_HOST="localhost"
DEFAULT_DB_PORT=5432
DEFAULT_DB_USER="yuvarajpattabi"
